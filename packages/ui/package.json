{
  "name": "@cosxai/ui",
  "version": "1.0.0-alpha.0",
  "description": "COSX Design System 3.0 — tokens, Tailwind v4 theme and React components",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./theme.css": "./src/theme.css",
    "./tokens/*": "./src/tokens/*"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosxai/product-design.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:css": "tailwindcss -i test/fixture.css -o test/out.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
