{
  "name": "@cosxai/chat",
  "version": "1.0.0-alpha.1",
  "description": "Agent conversation components for the COSX Design System 3.0 \u2014 messages, steps, citations, result and confirmation cards, composer, markdown",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./markdown.css": "./src/markdown.css"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosxai/product-design.git",
    "directory": "packages/chat"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.consumer.json",
    "test": "vitest run",
    "playground": "vite --config playground/vite.config.ts"
  },
  "dependencies": {
    "@cosxai/ui": "workspace:^",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0",
    "vitest-axe": "^0.1.0"
  }
}
