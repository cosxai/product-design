---
// Every page: title, search and share metadata (src/seo.json), icons, the
// kit's CSS, and prerender on hover.
import '../styles/site.css';
import seo from '../seo.json';

type Props = { title: string; lang?: 'en' | 'zh' | undefined };
const { title, lang = 'en' } = Astro.props;

const SITE = 'COSX Design System';
const ORIGIN = 'https://design.cosx.co';

// Built at /p/<route>[/zh|/ink|/zh-ink]; served at its clean path.
const path = Astro.url.pathname.replace(/^\/p/, '').replace(/\/(zh-ink|zh|ink)$/, '').replace(/^\/home$/, '/') || '/';
const meta = (seo as Record<string, { slug: string; title: string; description: string; index: boolean }>)[path];
const pageTitle = !meta || path === '/' ? SITE : `${meta.title} · ${SITE}`;
const description = meta?.description ?? 'Brand, foundations, components and product patterns of COSX.';
const url = ORIGIN + path;
const image = `${ORIGIN}/og/${meta?.slug ?? 'home'}.png`;
const imageAlt = meta && path !== '/' ? `${meta.title} — ${SITE}` : SITE;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${ORIGIN}/#website`, name: SITE, url: `${ORIGIN}/`, inLanguage: ['en-GB', 'zh-CN'], publisher: { '@id': 'https://www.cosx.co/#organization' } },
    {
      '@type': 'WebPage',
      '@id': url,
      url,
      name: pageTitle,
      description,
      isPartOf: { '@id': `${ORIGIN}/#website` },
      primaryImageOfPage: { '@type': 'ImageObject', url: image, width: 1200, height: 630 },
    },
    { '@type': 'Organization', '@id': 'https://www.cosx.co/#organization', name: 'COSX', legalName: 'COSINE X LTD', url: 'https://cosx.co' },
  ],
});
const speculation = JSON.stringify({
  prerender: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/*.*' } }] }, eagerness: 'moderate' }],
});
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en-GB'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Home' ? SITE : pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="robots" content={meta?.index === false ? 'noindex, follow' : 'index, follow'} />
    <meta name="theme-color" content="#FEFDFB" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:locale:alternate" content="zh_CN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@cosxai" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={jsonLd} />
    <script type="speculationrules" set:html={speculation} />
  </head>
  <body>
    <slot />
  </body>
</html>
