{"namespace":"COSXDesignSystem30_460d0b","components":[{"name":"Badge","sourcePath":"components/core/Badge.jsx"},{"name":"Button","sourcePath":"components/core/Button.jsx"},{"name":"Card","sourcePath":"components/core/Card.jsx"},{"name":"Figure","sourcePath":"components/core/Figure.jsx"},{"name":"Icon","sourcePath":"components/core/Icon.jsx"},{"name":"IconButton","sourcePath":"components/core/IconButton.jsx"},{"name":"Logo","sourcePath":"components/core/Logo.jsx"},{"name":"Marker","sourcePath":"components/core/Marker.jsx"},{"name":"MetaLabel","sourcePath":"components/core/MetaLabel.jsx"},{"name":"Tag","sourcePath":"components/core/Tag.jsx"},{"name":"Table","sourcePath":"components/data/Table.jsx"},{"name":"Dialog","sourcePath":"components/feedback/Dialog.jsx"},{"name":"Toast","sourcePath":"components/feedback/Toast.jsx"},{"name":"Tooltip","sourcePath":"components/feedback/Tooltip.jsx"},{"name":"Checkbox","sourcePath":"components/forms/Checkbox.jsx"},{"name":"Field","sourcePath":"components/forms/Field.jsx"},{"name":"Input","sourcePath":"components/forms/Input.jsx"},{"name":"Radio","sourcePath":"components/forms/Radio.jsx"},{"name":"Select","sourcePath":"components/forms/Select.jsx"},{"name":"Switch","sourcePath":"components/forms/Switch.jsx"},{"name":"Textarea","sourcePath":"components/forms/Textarea.jsx"},{"name":"Tabs","sourcePath":"components/navigation/Tabs.jsx"}],"startingPoints":[],"cards":[{"path":"guidelines/brand-backgrounds.card.html","group":"Brand","viewport":"700x180","subtitle":"Ink on paper, linen and the yellow; white on ink. Never on the accent, never yellow itself. Colour comes from the ground.","name":"Logo on backgrounds"},{"path":"guidelines/brand-chart-blocks.card.html","group":"Brand","viewport":"700x190","subtitle":"Ink is the base, yellow is the finding. One square is one organisation; 8px radius; the gap is the hairline.","name":"Chart blocks"},{"path":"guidelines/brand-clearspace.card.html","group":"Brand","viewport":"700x200","subtitle":"X = cap height of the CO loop, on all four sides.","name":"Clear space"},{"path":"guidelines/brand-grid.card.html","group":"Brand","viewport":"700x200","subtitle":"A faint 12-column hairline grid at --rule-soft sits beneath every layout. Content sits on the columns.","name":"The 12-column grid"},{"path":"guidelines/brand-lockup.card.html","group":"Brand","viewport":"700x150","subtitle":"Wordmark with the 4px yellow rule beneath, edition line in grey top right. Every social and report page opens this way.","name":"Wordmark lockup"},{"path":"guidelines/brand-logo.card.html","group":"Brand","viewport":"700x200","subtitle":"COSX wordmark & CO loop icon — light and inverted","name":"Logo"},{"path":"guidelines/brand-minsize.card.html","group":"Brand","viewport":"700x180","subtitle":"Wordmark ≥ 80px wide on screen, 22mm in print. Icon ≥ 16px / 5mm.","name":"Minimum size"},{"path":"guidelines/brand-misuse.card.html","group":"Brand","viewport":"700x200","subtitle":"No recolour, no stretch, no rotation, no shadow, no busy ground.","name":"Misuse"},{"path":"guidelines/brand-og-matrix.card.html","group":"Brand","viewport":"1100x640","subtitle":"Four grounds × figure (default panel), figure (alt panel), photo, type only. Set ground, side and panel in templates/og-image.","name":"Open Graph · all combinations"},{"path":"guidelines/brand-og.card.html","group":"Brand","viewport":"700x330","subtitle":"1200×630. Kind line, marker headline, logo + date footer. Right panel: figure, photo or none. Template: templates/og-image.","name":"Open Graph images"},{"path":"guidelines/brand-sections.card.html","group":"Brand","viewport":"700x230","subtitle":"Pages are stacked sections with 24px corners: paper, yellow field, ink. Mono index eyebrow, one regular-weight headline, field for the thing being said.","name":"Section fields"},{"path":"guidelines/brand-tile.card.html","group":"Brand","viewport":"700x200","subtitle":"Colour comes from the ground, never from the mark: the loop on a yellow tile for app icons, favicons, avatars and social profiles.","name":"Yellow tile"},{"path":"guidelines/colors-ends.card.html","group":"Colors","viewport":"700x160","subtitle":"Paper, linen, sunk 2, sunk 3 · ink, ink raised. Nothing in the middle.","name":"The two ends"},{"path":"guidelines/colors-family.card.html","group":"Colors","viewport":"700x200","subtitle":"One hue (85). Large areas take the field at low chroma; small areas — marker, blocks, rules, dots — take the accent with more chroma so they read as the same colour. Never lemon (hue 95).","name":"The yellow"},{"path":"guidelines/colors-inversion.card.html","group":"Colors","viewport":"700x180","subtitle":"The dark page. Headlines are linen; the finding is set in accent yellow with no band — on ink the yellow itself is the highlighter. Secondary text is --grey-inverse.","name":"Ink page"},{"path":"guidelines/colors-ladders.card.html","group":"Colors","viewport":"700x170","subtitle":"One hue, seven steps, light = less and deep = more. Treemaps, risk, single-hue series. Survives greyscale.","name":"Intensity ladder"},{"path":"guidelines/colors-status.card.html","group":"Colors","viewport":"700x170","subtitle":"Yellow, ink and one red. Shape does the rest: fill, outline, dot. Never on brand, marketing or deck surfaces.","name":"Product status (product UI only)"},{"path":"guidelines/colors-structure.card.html","group":"Colors","viewport":"700x150","subtitle":"Two greys, one per end. Rules are ink at low alpha so they adopt whichever paper they sit on.","name":"Greys and structure"},{"path":"guidelines/colors-yellow.card.html","group":"Colors","viewport":"700x150","subtitle":"Wash ladder for rows; intensity ladder for treemaps and single-hue series. Light = less, the accent = most; step 4 is the field.","name":"Washes and ladder"},{"path":"components/core/core.card.html","group":"Components","viewport":"700x600","subtitle":"Button, IconButton, Logo, Icon, MetaLabel, Marker, Figure, Badge, Tag, Card","name":"Core"},{"path":"components/data/data.card.html","group":"Components","viewport":"700x330","subtitle":"Table — register with status rows","name":"Data"},{"path":"components/feedback/feedback.card.html","group":"Components","viewport":"700x380","subtitle":"Dialog, Toast, Tooltip","name":"Feedback"},{"path":"components/forms/forms.card.html","group":"Components","viewport":"700x560","subtitle":"Input, Textarea, Select (styled, searchable), Checkbox, Radio, Switch, Field","name":"Forms"},{"path":"components/navigation/navigation.card.html","group":"Components","viewport":"700x220","subtitle":"Tabs — underline and pills","name":"Navigation"},{"path":"slides/CardGridSlide.html","group":"Slides","viewport":"1280x720","subtitle":"Paper ground. Three linen panels: a large index number at the top, title and body pinned to the bottom, status as a quiet pill.","name":"05 · Card grid"},{"path":"slides/ChartSlide.html","group":"Slides","viewport":"1280x720","subtitle":"Paper ground. Ink is the base, yellow is the finding; rounded columns, mono axis.","name":"07 · Chart"},{"path":"slides/CloseSlide.html","group":"Slides","viewport":"1280x720","subtitle":"Ink ground. Icon, closing line at 60px in yellow, the tagline, a three-column contact row. From the pre-seed deck v3.","name":"09 · Close"},{"path":"slides/ContentPanelSlide.html","group":"Slides","viewport":"1280x720","subtitle":"Paper ground. Bold heading, lead, three points; figures in a rounded yellow-field panel.","name":"04 · Content with side panel"},{"path":"slides/CoverSlide.html","group":"Slides","viewport":"1280x720","subtitle":"Ink ground. Wordmark with yellow rule, 76px linen title, the finding in accent yellow — no band.","name":"01 · Cover"},{"path":"slides/FieldSlide.html","group":"Slides","viewport":"1280x720","subtitle":"Yellow-field ground with 24px corners inset on linen. Headline centred at regular weight, four hairline columns beneath.","name":"10 · Field"},{"path":"slides/SectionSlide.html","group":"Slides","viewport":"1280x720","subtitle":"Ink ground. 120px numeral in yellow, title, one line of framing.","name":"02 · Section divider"},{"path":"slides/StatementSlide.html","group":"Slides","viewport":"1280x720","subtitle":"Ink ground. One claim at 56px in linen, the finding in accent yellow, a source. Nothing else.","name":"03 · Statement"},{"path":"slides/StatRowSlide.html","group":"Slides","viewport":"1280x720","subtitle":"Paper ground. Four figures at 64px bold, a 40px yellow rule under each. Sourced or removed.","name":"06 · Stat row"},{"path":"slides/TableSlide.html","group":"Slides","viewport":"1280x720","subtitle":"Paper ground. Mono head, tabular figures, the finding row washed in yellow.","name":"08 · Table"},{"path":"guidelines/elevation.card.html","group":"Spacing","viewport":"700x190","subtitle":"Nothing lifts. Depth is cut into the page: three sunk steps and a scrim. There are no shadows.","name":"Elevation"},{"path":"guidelines/motion-vocabulary.card.html","group":"Spacing","viewport":"700x420","subtitle":"Paper settling. Six entry moves and one glide, all ease-out, ≤640ms each, 70ms stagger. Click the card to replay.","name":"Motion vocabulary"},{"path":"guidelines/motion.card.html","group":"Spacing","viewport":"700x170","subtitle":"Hover, focus, toggle: 120 / 180 / 320ms, flat easing. Entry moves are on the next card.","name":"Motion · state"},{"path":"guidelines/radius-borders.card.html","group":"Spacing","viewport":"700x170","subtitle":"A radius ladder: 6px tags, 8px buttons and chart blocks, 16px panels, 24px whole sections, pill on dots. Rules are 1, 4 or 8px.","name":"Radius, rules and states"},{"path":"guidelines/spacing-inuse.card.html","group":"Spacing","viewport":"700x230","subtitle":"32px card padding, 8px label gap, 24px between blocks, 64px section margins.","name":"Spacing in use"},{"path":"guidelines/spacing-scale.card.html","group":"Spacing","viewport":"700x150","subtitle":"4px base — generous whitespace","name":"Spacing scale"},{"path":"guidelines/type-body.card.html","group":"Type","viewport":"700x180","subtitle":"Geist regular — ink body, grey secondary","name":"Body & secondary"},{"path":"guidelines/type-display.card.html","group":"Type","viewport":"700x210","subtitle":"Geist 700, tracked -.03em, leading 1.0. One phrase carries the finding and takes the yellow marker.","name":"Headlines and the marker"},{"path":"guidelines/type-family.card.html","group":"Type","viewport":"700x170","subtitle":"One family. Geist for everything — hierarchy comes from size and the yellow, not from a second face.","name":"Type family"},{"path":"guidelines/type-figures.card.html","group":"Type","viewport":"700x180","subtitle":"Numbers carry the weight. Geist 700, tabular, a 40px yellow rule and a mono label. Sourced or removed.","name":"Figures"},{"path":"guidelines/type-mono.card.html","group":"Type","viewport":"700x150","subtitle":"Geist 12px medium, sentence case, grey. No caps, no tracking, no second face.","name":"Labels and metadata"},{"path":"guidelines/type-cjk-bilingual.card.html","group":"Type · 中文","viewport":"700x220","subtitle":"中文在前，英文跟在后面，小一号（0.72em），次要灰。数字只出现一次，放在中文行里。","name":"双语排法"},{"path":"guidelines/type-cjk-family.card.html","group":"Type · 中文","viewport":"700x200","subtitle":"汉字用 Noto Sans SC（与思源黑体同一设计），英文与数字仍走 Geist。只用 400 与 500，全系统不出现 700。","name":"Noto Sans SC · 字重"},{"path":"guidelines/type-cjk-marker.card.html","group":"Type · 中文","viewport":"700x220","subtitle":"汉字几乎填满字框，高亮带从 50% 起（英文为 40%）。黑底上同样不带高亮带，改用强调黄字。","name":"中文高亮划线"},{"path":"guidelines/type-cjk-mixed.card.html","group":"Type · 中文","viewport":"700x280","subtitle":"汉字走 Noto Sans SC，英文数字走 Geist；中英之间自动留四分之一空格，全角标点，字距为 0。","name":"中英混排"},{"path":"ui_kits/website/index.html","group":"Website","viewport":"1280x800","subtitle":"Marketing site: text nav, marker hero with a product preview in the yellow field, steps, ink band, practices","name":"Website — home"},{"path":"ui_kits/workspace/index.html","group":"Workspace","viewport":"1180x720","subtitle":"Sidebar app: paper rail, one yellow strip for the finding, stat tiles, 12px panels; yellow + ink + one red for status","name":"Workspace — dashboard"}],"templates":[{"name":"Brand guidelines deck","description":"COSX 3.0 brand manual — 16 slides at 1280×720: idea, logo, colour, type, marker, shape, status, website, workspace, social, voice, misuse.","folder":"templates/brand-guidelines","entryPath":"templates/brand-guidelines/BrandGuidelines.dc.html","thumbnail":{"path":"templates/brand-guidelines/.thumbnail","kind":"captured"}},{"name":"Investor teaser · 中文","description":"A4 中文投资人一页纸：带高亮的标题、黄色条上的四个关键数字、问题与方案、市场、模式、团队，以及黑底上的融资需求。","folder":"templates/investor-teaser-zh","entryPath":"templates/investor-teaser-zh/InvestorTeaserZh.dc.html","thumbnail":{"path":"templates/investor-teaser-zh/.thumbnail","kind":"captured"}},{"name":"Investor teaser (one page)","description":"A4 one-pager for prospective investors: headline with the marker, four key figures on a yellow strip, problem/solution, market, model, team, and the ask on ink. Filled from the pre-seed deck v3.","folder":"templates/investor-teaser","entryPath":"templates/investor-teaser/InvestorTeaser.dc.html","thumbnail":{"path":"templates/investor-teaser/.thumbnail","kind":"captured"}},{"name":"Open Graph image","description":"1200×630 link-preview image: kind line, headline with the marker, logo + date footer; optional figure panel or photo panel on the right. Four grounds.","folder":"templates/og-image","entryPath":"templates/og-image/OgImage.dc.html","thumbnail":{"path":"templates/og-image/.thumbnail","kind":"captured"}},{"name":"Social · Column chart","description":"1080×1350 social graphic: bold headline with a yellow marker, rounded columns by year in ink with the finding years in yellow.","folder":"templates/social-columns","entryPath":"templates/social-columns/SocialColumns.dc.html","thumbnail":{"path":"templates/social-columns/.thumbnail","kind":"captured"}},{"name":"Social · Treemap","description"